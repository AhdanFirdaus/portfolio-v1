# EmailJS Contact Form Credentials
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Notion API Integration Keys
NOTION_API_KEY=secret_your_notion_api_integration_key

# Option A: Separate Notion Databases (Recommended)
NOTION_AWARDS_DB_ID=your_awards_notion_database_id
NOTION_COMPLETIONS_DB_ID=your_completions_notion_database_id

# Option B: Single Combined Database (Fallback)
NOTION_CERTIFICATES_DB_ID=your_certificates_notion_database_id

# Notion CTF Writeups / Blog Database
NOTION_BLOG_DB_ID=your_blog_notion_database_id